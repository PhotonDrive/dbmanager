{
  "name": "dbmanager",
  "version": "1.0.0",
  "description": "database manager for sqlite",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "build": "tsup && npm run ugly",
    "tbuild": "tsup",
    "ugly": "uglifyjs --compress --mangle --output ./dist/index.min.js -- ./dist/index.js ",
    "clean": "rimraf ./dist/ ./coverage",
    "lint": "eslint ./src/",
    "lint:fix": "eslint ./src/ --fix",
    "watch:test": "jest --watchAll",
    "test": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "watch": "npm run watch:ts",
    "watch:ts": "tsc -p ./tsconfig.json -w"
  },
  "license": "MIT",
  "author": {
    "name": "Nilesh Kodolikar",
    "email": "kodolikar.nilesh@gmail.com",
    "url": "https://github.com/protondrive"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.7.1",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "jest": "^30.2.0",
    "jiti": "^2.6.1",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.5",
    "tslib": "^2.8.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.40.0",
    "uglify-js": "^3.19.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "lint-staged": {
    "*.ts": "eslint --cache --cache-location .eslintcache --fix"
  }
}
